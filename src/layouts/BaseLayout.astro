---
import '../styles/tokens.css';
import '../styles/global.css';
import SEO from '../components/SEO.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
}
const { title, description, image, article } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <SEO title={title} description={description} image={image} article={article} />
  </head>
  <body>
    <a href="#top" class="skip-link">Skip to content</a>

    <div class="preloader" id="preloader">
      <img class="preloader-logo" src="/images/logo.png" alt="" width="64" height="64" />
      <div class="preloader-count" id="preload-count">0%</div>
    </div>

    <div class="cur-dot" id="curDot" aria-hidden="true"></div>
    <div class="cur-ring" id="curRing" aria-hidden="true"></div>

    <slot />
  </body>
</html>
