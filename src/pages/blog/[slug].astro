---
import { getEntry, getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Img from '../../components/Img.astro';
import { getPublishedPosts, byOrder } from '../../lib/content';

// Only published posts get a route — drafts are never generated (Property 4).
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const contact = (await getEntry('contact', 'main'))!.data;
const social = byOrder(await getCollection('social')).map((e) => e.data);
const dateFmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<BaseLayout title={post.data.title} description={post.data.excerpt} image={post.data.coverImage || undefined} article={true}>
  <Nav />
  <main id="top">
    <article class="post">
      <a href="/blog" class="back-link" data-hover>← Back to blog</a>
      <h1>{post.data.title}</h1>
      <div class="post-meta">{dateFmt.format(post.data.publishDate)} · {post.data.author}</div>
      {post.data.coverImage && (
        <div class="cover"><Img src={post.data.coverImage} alt={post.data.title} loading="eager" /></div>
      )}
      {post.data.tags.length > 0 && (
        <div class="tag-row" style="margin-bottom:30px;">{post.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
      )}
      <div class="post-body"><Content /></div>
    </article>
  </main>
  <Footer contact={contact} social={social} />
</BaseLayout>
