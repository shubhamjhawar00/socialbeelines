---
import { getEntry, getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Img from '../../components/Img.astro';
import { getPublishedPosts, byOrder } from '../../lib/content';

const posts = await getPublishedPosts();
const contact = (await getEntry('contact', 'main'))!.data;
const social = byOrder(await getCollection('social')).map((e) => e.data);
const dateFmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<BaseLayout title="Blog" description="Notes on social media, branding, and digital marketing from the Social Beelines team.">
  <Nav />
  <main id="top">
    <div class="page-top wrap">
      <div class="kicker">The blog</div>
      <h1 class="blog-hero-title">Notes from the hive.</h1>
    </div>
    <div class="wrap">
      {posts.length === 0 ? (
        <p style="padding:40px 0 120px;color:var(--blue-70);font-weight:500;">No posts published yet. Add one through the CMS.</p>
      ) : (
        <div class="blog-grid">
          {posts.map((post) => (
            <a class="blog-card" href={`/blog/${post.slug}/`} data-hover>
              <div class="cover"><Img src={post.data.coverImage} alt={post.data.title} /></div>
              <div class="meta">{dateFmt.format(post.data.publishDate)} · {post.data.author}</div>
              <h3>{post.data.title}</h3>
              <p class="excerpt">{post.data.excerpt}</p>
              {post.data.tags.length > 0 && (
                <div class="tag-row">{post.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
              )}
            </a>
          ))}
        </div>
      )}
    </div>
  </main>
  <Footer contact={contact} social={social} />
</BaseLayout>
