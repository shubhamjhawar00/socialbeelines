---
/**
 * Image_Slot renderer.
 * - If `src` is empty/undefined, renders a branded placeholder (Req 6.2, Property 9).
 * - Requires `alt`; for decorative images pass alt="" and decorative={true}.
 */
export interface Props {
  src?: string | null;
  alt?: string;
  decorative?: boolean;
  class?: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
}
const {
  src,
  alt = '',
  decorative = false,
  class: className,
  width,
  height,
  loading = 'lazy',
} = Astro.props;

const hasImage = typeof src === 'string' && src.trim().length > 0;
if (hasImage && !decorative && alt.trim().length === 0) {
  throw new Error(
    `Img: non-decorative image "${src}" is missing alt text (accessibility requirement 2.3 / 6.5).`
  );
}
---
{hasImage ? (
  <img
    src={src}
    alt={decorative ? '' : alt}
    class={className}
    width={width}
    height={height}
    loading={loading}
    decoding="async"
  />
) : (
  <div class:list={['img-placeholder', className]} role="img" aria-label={decorative ? undefined : alt || 'Image placeholder'} aria-hidden={decorative ? 'true' : undefined}>
    <svg viewBox="0 0 24 24" fill="none" width="28" height="28" aria-hidden="true">
      <path d="M4 5h16v14H4zM4 15l4-4 4 4 3-3 5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="9" cy="9" r="1.6" fill="currentColor"/>
    </svg>
  </div>
)}

<style>
  .img-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: 120px;
    color: var(--blue-40);
    background: var(--blue-10);
    border: 1px dashed var(--blue-20);
  }
</style>
