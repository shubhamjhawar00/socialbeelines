---
import type { CollectionEntry } from 'astro:content';
export interface Props { hero: CollectionEntry<'hero'>['data']; }
const { hero } = Astro.props;
const arrow = 'M7 17L17 7M17 7H8M17 7V16';
---
<section class="hero">
  <div class="hero-bg" id="heroBg" aria-hidden="true"></div>
  <div class="wrap">
    <div class="hero-eyebrow"><span class="dot"></span> {hero.eyebrow}</div>
    <h1 class="hero-title" id="heroTitle">
      {hero.titleLines.map((line) => (
        <span class="line"><span class="reveal-inner">{line.words.map((w, i) => (
          <><span class:list={['word', { accent: w.accent }]}>{w.text}</span>{i < line.words.length - 1 ? ' ' : ''}</>
        ))}</span></span>
      ))}
    </h1>
    <div class="hero-sub">
      <p class="hero-desc">{hero.description}</p>
      <div class="magnetic" data-magnetic>
        <a href={hero.ctaHref} class="hero-cta" data-hover>
          {hero.ctaLabel}
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d={arrow} stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </div>
  <div class="scroll-indicator"><div class="scroll-line"></div> Scroll</div>
</section>
